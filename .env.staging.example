APP_NAME=PhishGuard API (Staging)
APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS setup (comma-separated list of origins)
ALLOWED_CORS_ORIGINS=https://frontend-staging.example.com,https://dashboard-staging.example.com

# Allowed hosts list for TrustedHostMiddleware (includes real domain and internal container hosts)
ALLOWED_HOSTS=api-staging.example.com,localhost,127.0.0.1,api

# Database configuration (Staging PostgreSQL)
DATABASE_URL=postgresql+psycopg://phishguard_stage_user:STAGE_SECURE_PASSWORD@postgres-stage-host.com:5432/phishguard_stage_db
DATABASE_ECHO=false

# Authentication Secrets (Generate secure, long keys)
JWT_SECRET_KEY=PLACEHOLDER_STAGING_SECRET_SIGNING_KEY_REPLACE_ME_SECURELY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Production Hardening
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO

# Strict HSTS configuration (Only active over HTTPS)
ENABLE_HSTS=true
HSTS_MAX_AGE=86400
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
